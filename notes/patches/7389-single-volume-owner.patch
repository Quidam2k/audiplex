+
+    /** #7389: what the volume owner does when the app's music level (dial x track gain) changes. */
+    enum class BaseAction {
+        /** Not ducked, nothing ramping: write it now. */
+        WriteNow,
+        /** Ducked (or ducking): keep the duck, restore to the new level later. */
+        HoldUnderDuck,
+        /** An un-duck is ramping: ramp to the new level instead of the old one. */
+        RetargetRestore,
+    }
+
+    fun onBaseChange(ducked: Boolean, restoring: Boolean): BaseAction = when {
+        ducked -> BaseAction.HoldUnderDuck
+        restoring -> BaseAction.RetargetRestore
+        else -> BaseAction.WriteNow
+    }
 }
