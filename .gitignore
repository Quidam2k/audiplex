# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.venv/
venv/

# Server config (contains jwt_secret + machine-specific paths)
server/config.yaml

# DJ service-account JWT — single-source token file read by audiplex_mcp
# when AUDIPLEX_TOKEN env is unset (rotation = re-mint + overwrite this file)
.dj_token

# Server runtime artifacts (regenerated from the library)
server/audiplex.db
server/*.db.pre-*-backup
server/*.db.bak-*
server/audiplex.db-journal
server/audiplex.db-wal
server/audiplex.db-shm
server/covers/

# Android / Gradle
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.iml

# Android version counter (auto-incremented on each build)
android/version.properties

# Local agent settings + session planning notes (personal context)
.claude/
cascades/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Junk
nul
pty_injection.log

# Pantheon orchestrator files that land in this dir but aren't part of audiplex
.mcp.json
start_worker.bat

# Personal handoff / debugging notes (machine-specific paths)
NOTE-*.md
